# ProtocolX RISC-V Pipelined Processor
# Git Ignore Rules

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# EDA & Simulation build artifacts
*.vvp
*.log.tmp
*.swp
*.bak
*~

# Keep reference simulation files, ignore large transient runs
simulation/*.vvp
simulation/tmp_*

# Synthesis transcript (regenerated by `make synth`)
synth/synth_report.log

# Team members' face/voice reference clips: private, keep local only
video/presenter_pick/

# FPGA flow outputs that are large or regenerated (keep *.nextpnr.log and *.utilization.txt as evidence)
fpga/results/*.json
fpga/results/*.yosys.log
docs/IEEE_Phase2_Project_Report.html
